  "age": 55,
  "bp": 80,
  "sg": 1.010,
  "al": 3,
  "su": 2,
  "bgr": 148,
  "bu": 75,
  "sc": 4.5,
  "sod": 134,
  "pot": 4.8,
  "hemo": 10,
  "pcv": 32,
  "wbcc": 9200,
  "rbcc": 3.6
}

