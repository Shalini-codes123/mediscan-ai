{
  "folders": [
    { "path": "." }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/node_modules": true,
      "venv": true,
      "data": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.black-formatter",
      "dsznajder.es7-react-js-snippets",
      "esbenp.prettier-vscode",
      "eamodio.gitlens",
      "humao.rest-client",
      "ms-vscode.live-server"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Flask Backend",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/backend/app.py",
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "FLASK_DEBUG": "true",
          "PORT": "5000"
        },
        "console": "integratedTerminal"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Start Flask Backend",
        "type": "shell",
        "command": "source venv/bin/activate && cd backend && python app.py",
        "group": "build",
        "presentation": { "panel": "new" }
      },
      {
        "label": "Start React Frontend",
        "type": "shell",
        "command": "cd frontend && npm run dev",
        "group": "build",
        "presentation": { "panel": "new" }
      },
      {
        "label": "Train Models (Kaggle)",
        "type": "shell",
        "command": "source venv/bin/activate && python scripts/download_and_train.py",
        "group": "build",
        "presentation": { "panel": "new" }
      },
      {
        "label": "Run Tests",
        "type": "shell",
        "command": "source venv/bin/activate && cd backend && pytest tests/ -v",
        "group": "test",
        "presentation": { "panel": "new" }
      },
      {
        "label": "Build Frontend for Production",
        "type": "shell",
        "command": "cd frontend && npm run build",
        "group": "build",
        "presentation": { "panel": "new" }
      }
    ]
  }
}